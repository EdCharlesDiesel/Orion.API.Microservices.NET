{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "HealthChecks-UI": {
    "HealthChecks": [
      {
        "Name": "Health Checks",
        "Uri": "http://localhost:5000/health"
      }

    ],
    "EvaluationTimeOnSeconds": 10,
    "MinimumSecondsBetweenFailureNotifications": 60
  }
}
