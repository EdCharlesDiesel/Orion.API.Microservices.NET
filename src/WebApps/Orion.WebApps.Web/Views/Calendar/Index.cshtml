@model List<Orion.StockAnalyzer.Core.Domain.Calendar>

@{
    ViewData["Title"] = "Calendar Events";
}

<h1>Calendar Events</h1>

<table class="table table-bordered">
    <thead>
    <tr>
        <th>Event Name</th>
        <th>Date</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.EventName</td>
            <td>@item.Date.ToString("dddd, MMM dd yyyy hh:mm tt")</td>
            <td><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning">Edit</a></td>
            <td><a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger">Delete</a></td>
            <td><a asp-action="Index" class="btn btn-secondary">Back to List</a></td>
        </tr>
    }
    </tbody>
    </table>